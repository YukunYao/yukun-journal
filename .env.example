# Public browser configuration. The publishable key is safe to expose; never use a service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel server environment only. Never prefix these with VITE_ or commit their values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_CLINICAL_APPROVED=false
